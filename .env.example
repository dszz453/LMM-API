# ============================================================
# LMM-API 部署环境变量（复制为 .env 后修改）
#
#   cp .env.example .env
#   然后编辑 .env 填入你自己的密码和地址
#
# docker compose 会自动读取同目录下的 .env 文件。
# ============================================================

# 初始管理员账号（容器首次启动时自动创建，至少 8 位密码）
INIT_ROOT_USER=root
INIT_ROOT_PASSWORD=change-me-please

# 对外访问地址：填你实际访问用的局域网 IP 或域名，勿写 localhost
SERVER_ADDRESS=http://192.168.31.180:3000

# 自动初始化开关：auto（默认）/ force / off
INIT_AUTO_SETUP=auto

# 时区
TZ=Asia/Shanghai
